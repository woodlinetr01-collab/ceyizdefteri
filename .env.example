# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerlerinizi girin.
# .env dosyası .gitignore içinde olduğundan Git'e gönderilmez.

# Supabase — Project Settings > API sayfasından alın.
# Yalnızca "anon / public" key'i buraya koyun. "service_role" key'i ASLA
# frontend'e veya bu dosyaya koymayın.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# İleride: Stripe (web ödeme) — yalnızca publishable key frontend'e girilir.
VITE_STRIPE_PUBLISHABLE_KEY=

# İleride: gerçek bir LLM sağlayıcısına bağlanmak isterseniz (services/aiAssistant.js
# şu an kural tabanlı ve yerel çalışır — hiçbir dış API çağırmaz). Vite'ta
# VITE_ ön ekiyle başlayan HER değişken derlenen JS içine gömülür ve
# tarayıcıdan herkes tarafından okunabilir. Bu yüzden gerçek bir sağlayıcı
# API anahtarını ASLA burada veya başka bir VITE_ değişkeninde saklamayın.
#
# Doğru mimari: kendi backend'inizde (örn. bir Vercel Serverless/Edge
# Function) bir uç nokta açın, gerçek anahtarı YALNIZCA o fonksiyonun kendi
# ortam değişkenlerinde (Vercel Dashboard, VITE_ öneki OLMADAN) saklayın.
# Frontend yalnızca bu uç noktanın (gizli olmayan) adresini bilir:
VITE_AI_ASSISTANT_MODE=rule-based
VITE_AI_API_BASE_URL=
